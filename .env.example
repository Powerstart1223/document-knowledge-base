# LLM Provider — "ollama" (local, default) or "openai" (cloud)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenAI API Key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# SEC EDGAR — free, public API. Requires a User-Agent with name + email.
SEC_EDGAR_USER_AGENT=YourName your@email.com

# ChromaDB settings
CHROMA_DB_PATH=./chroma_db

# Streamlit settings
STREAMLIT_SERVER_PORT=8501

# NetDocuments Integration (Optional)
NETDOCUMENTS_CLIENT_ID=your_netdocuments_client_id
NETDOCUMENTS_CLIENT_SECRET=your_netdocuments_client_secret
NETDOCUMENTS_REDIRECT_URI=https://localhost:3000/gettoken

# Westlaw / LexisNexis (requires commercial API subscription)
LEGAL_DB_API_KEY=
