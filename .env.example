# ======================================================================
# Corporate Law Document Generator - Environment Configuration
# ======================================================================
# Copy this file to .env for local development
# DO NOT commit .env file - it contains secrets!
# For Streamlit Cloud: use the Secrets dashboard instead

# ======================================================================
# LLM Provider Configuration
# ======================================================================

# Provider: "ollama" (local only) or "openai" (cloud-compatible)
# For Streamlit Cloud deployment, use "openai"
LLM_PROVIDER=openai

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local development only)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ======================================================================
# External Data Sources (Optional)
# ======================================================================

# SEC EDGAR — free, public API (just provide User-Agent with your contact info)
SEC_EDGAR_USER_AGENT=YourName your@email.com

# NetDocuments Integration (requires NetDocuments account)
NETDOCUMENTS_CLIENT_ID=
NETDOCUMENTS_CLIENT_SECRET=
NETDOCUMENTS_REDIRECT_URI=https://localhost:3000/gettoken

# Westlaw / LexisNexis (requires commercial API subscription)
LEGAL_DB_API_KEY=

# ======================================================================
# Application Settings
# ======================================================================

# ChromaDB path (local development)
CHROMA_DB_PATH=./chroma_db

# Streamlit server port (local development)
STREAMLIT_SERVER_PORT=8501

# ======================================================================
# Continuous Learning Pipeline Configuration
# ======================================================================

# Paths to scan for documents (comma-separated)
# Default: C:/Users/SJK/Documents/,E:/etdocumentsdownload/
SCAN_PATHS=C:/Users/SJK/Documents/,E:/etdocumentsdownload/

# Background scan interval in minutes (default: 30)
SCAN_INTERVAL_MINUTES=30

# Auto-start background scanner on app launch (true/false)
AUTO_SCAN_ENABLED=true
