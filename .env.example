# ======================================================================
# Corporate Law Document Generator - Environment Configuration
# ======================================================================
# Copy this file to .env for local development
# DO NOT commit .env file - it contains secrets!
# For Streamlit Cloud: use the Secrets dashboard instead

# ======================================================================
# LLM Provider Configuration
# ======================================================================

# Provider: "ollama" (local only) or "openai" (cloud-compatible)
# For Streamlit Cloud deployment, use "openai"
LLM_PROVIDER=openai

# OpenAI Configuration (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local development only)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434/v1

# ======================================================================
# External Data Sources (Optional)
# ======================================================================

# SEC EDGAR — free, public API (just provide User-Agent with your contact info)
SEC_EDGAR_USER_AGENT=YourName your@email.com

# Westlaw / LexisNexis (requires commercial API subscription)
LEGAL_DB_API_KEY=

# ======================================================================
# Application Settings
# ======================================================================

# ChromaDB path (local development)
CHROMA_DB_PATH=./chroma_db

# Streamlit server port (local development)
STREAMLIT_SERVER_PORT=8501

# Registration domain policy
# Use '*' (or 'any') to allow all email domains
# Or provide a comma-separated list, e.g. cypressllp.com,partnerfirm.com
ALLOWED_EMAIL_DOMAINS=*
REQUIRE_EMAIL_VERIFICATION=false

# Bootstrap admin account (created only when users.db has no users)
BOOTSTRAP_ADMIN_EMAIL=admin@cypressllp.com
BOOTSTRAP_ADMIN_PASSWORD=

# ======================================================================
# Continuous Learning Pipeline Configuration
# ======================================================================

# Paths to scan for documents (comma-separated)
# Default: C:/Users/SJK/Documents/,E:/etdocumentsdownload/
SCAN_PATHS=C:/Users/SJK/Documents/,E:/etdocumentsdownload/

# Background scan interval in minutes (default: 30)
SCAN_INTERVAL_MINUTES=30

# Auto-start background scanner on app launch (true/false)
AUTO_SCAN_ENABLED=true

# ======================================================================
# Email Verification (SMTP)
# ======================================================================

# SMTP server for sending verification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@your-domain.com
ENFORCE_WEB_SECURITY=true
REQUIRE_HTTPS=true
ALLOW_INSECURE_LOCALHOST=true
STRICT_HOST_VALIDATION=true
TRUSTED_HOSTS=localhost,127.0.0.1,::1
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ABSOLUTE_TIMEOUT_HOURS=8
LOGIN_MAX_ATTEMPTS_PER_WINDOW=6
LOGIN_WINDOW_SECONDS=60
LOGIN_COOLDOWN_SECONDS=90
