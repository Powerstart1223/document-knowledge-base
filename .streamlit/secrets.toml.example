# Streamlit Cloud Secrets Configuration
# Copy this file to .streamlit/secrets.toml locally (DO NOT commit secrets.toml!)
# On Streamlit Cloud: paste these into the Secrets section of your app dashboard

# ======================================================================
# LLM Provider Configuration
# ======================================================================

# Provider: "ollama" (local only) or "openai" (cloud-compatible)
# On Streamlit Cloud, use "openai" since Ollama requires local installation
LLM_PROVIDER = "openai"

# OpenAI Configuration (required if LLM_PROVIDER = "openai")
OPENAI_API_KEY = "sk-proj-..."  # Your OpenAI API key from https://platform.openai.com/api-keys
OPENAI_MODEL = "gpt-4o-mini"  # Options: gpt-4, gpt-4-turbo, gpt-4o, gpt-4o-mini, gpt-3.5-turbo

# Ollama Configuration (only for local development)
OLLAMA_MODEL = "llama3.1:8b"
OLLAMA_BASE_URL = "http://localhost:11434/v1"

# ======================================================================
# External Data Sources (Optional)
# ======================================================================

# SEC EDGAR API (free, no key required, just provide User-Agent)
SEC_EDGAR_USER_AGENT = "YourName your@email.com"

# NetDocuments OAuth (optional — requires NetDocuments account)
NETDOCUMENTS_CLIENT_ID = ""
NETDOCUMENTS_CLIENT_SECRET = ""
NETDOCUMENTS_REDIRECT_URI = "https://localhost:3000/gettoken"

# Westlaw / LexisNexis (optional — requires commercial API subscription)
LEGAL_DB_API_KEY = ""
